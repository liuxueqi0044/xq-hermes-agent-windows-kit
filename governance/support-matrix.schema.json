{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xq.invalid/schemas/support-matrix.schema.json",
  "title": "XQ Hermes support matrix",
  "type": "object",
  "required": ["schemaVersion", "productVersion", "supportedOs", "entries", "policy"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "productVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "supportedOs": {"const": ["Windows 11 x64"]},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["hermesVersion", "runtimeCommit", "status", "acceptanceRecord"], "properties": {"hermesVersion": {"type": "string"}, "runtimeCommit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|PENDING_REAL_VM)$"}, "status": {"enum": ["VALIDATED", "PENDING_VM_ACCEPTANCE", "WITHDRAWN"]}, "acceptanceRecord": {"type": "string", "minLength": 1}}}},
    "policy": {"type": "string", "minLength": 1}
  }
}
