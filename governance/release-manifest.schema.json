{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xq.invalid/schemas/release-manifest.schema.json",
  "title": "XQ release manifest",
  "type": "object",
  "required": ["schemaVersion", "releaseId", "releaseTag", "tagCommitSha", "productVersion", "hermesVersion", "semver", "supportMatrix", "supportScopeSha256", "acceptanceRecord", "artifact", "releaseStatus", "knownIssues", "unsupported", "oldArtifactPolicy"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "releaseId": {"type": "string", "pattern": "^XQ-[0-9]+\\.[0-9]+\\.[0-9]+-Hermes-.+$"},
    "releaseTag": {"type": "string", "pattern": "^xq-v[0-9]+\\.[0-9]+\\.[0-9]+-hermes-[0-9A-Za-z._-]+$"},
    "tagCommitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "productVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "hermesVersion": {"type": "string", "minLength": 1},
    "semver": {"type": "object", "required": ["major", "minor", "patch"], "properties": {"major": {"type": "integer", "minimum": 0}, "minor": {"type": "integer", "minimum": 0}, "patch": {"type": "integer", "minimum": 0}}},
    "supportMatrix": {"type": "object", "required": ["status", "hermesVersion", "supportedOs"], "properties": {"status": {"const": "VALIDATED"}, "hermesVersion": {"type": "string"}, "supportedOs": {"const": ["Windows 11 x64"]}}},
    "supportScopeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "acceptanceRecord": {"type": "object", "required": ["path", "sha256", "state"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "state": {"const": "PASSED"}}},
    "artifact": {"type": "object", "required": ["path", "sha256", "immutable"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "immutable": {"const": true}}},
    "releaseStatus": {"enum": ["CANDIDATE", "RELEASED", "WITHDRAWN"]},
    "knownIssues": {"type": "array", "items": {"type": "string"}},
    "unsupported": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "oldArtifactPolicy": {"type": "string", "minLength": 1}
  }
}
